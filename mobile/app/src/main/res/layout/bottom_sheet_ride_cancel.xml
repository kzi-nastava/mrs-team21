<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ride_history_details_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:background="@drawable/bg_ride_history_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancelSheetTitle"
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ride_tracking_cancel_sheet_title_driver"
            android:textSize="@dimen/text_lg" />

        <ImageView
            android:id="@+id/cancelCloseButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_ride_history_sheet_close"
            android:contentDescription="@string/ride_tracking_cancel_close"
            android:padding="7dp"
            android:src="@drawable/ic_close_simple"
            app:tint="@color/text_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/cancelStatusText"
        style="@style/TextStyle.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_estimate_note"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingTop="5dp"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingBottom="5dp"
        android:text="@string/ride_tracking_cancel_status_assigned"
        android:textColor="@color/text_dark"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_route_dot_start" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextStyle.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ride_tracking_from" />

                            <TextView
                                android:id="@+id/cancelPickupAddress"
                                style="@style/TextStyle.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_route_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_route_dot_end" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextStyle.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ride_tracking_to" />

                            <TextView
                                android:id="@+id/cancelDestinationAddress"
                                style="@style/TextStyle.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cancelCounterpartyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/cancelCounterpartyAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_profile_avatar"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cancelCounterpartyName"
                            style="@style/TextStyle.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/cancelCounterpartyMeta"
                            style="@style/TextStyle.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/cancelDriverSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    style="@style/TextStyle.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ride_tracking_cancel_reason_prompt"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/cancelReasonGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <RadioButton
                        android:id="@+id/reasonPersonalEmergency"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_cancel_reason_personal_emergency"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/reasonVehicleIssue"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_cancel_reason_vehicle_issue"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/reasonUnsafePickup"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_cancel_reason_unsafe_pickup"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/reasonPassengerAbsent"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_cancel_reason_passenger_absent"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/reasonOther"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_cancel_reason_other"
                        android:textColor="@color/text_dark" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/cancelExplanationLayout"
                    style="@style/Widget.Drumigo.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/ride_tracking_cancel_explanation_hint"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/cancelExplanationInput"
                        style="@style/Widget.Drumigo.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="4"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/TextStyle.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_estimate_note"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/ride_tracking_cancel_driver_warning" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cancelPassengerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextStyle.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ride_tracking_cancel_passenger_title"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextStyle.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_estimate_note"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/ride_tracking_cancel_passenger_policy" />
            </LinearLayout>

            <TextView
                android:id="@+id/cancelNotAllowedText"
                style="@style/TextStyle.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_info_box"
                android:padding="@dimen/spacing_md"
                android:text="@string/ride_tracking_cancel_not_available_generic"
                android:textColor="@color/text_dark"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cancelErrorText"
                style="@style/TextStyle.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/error"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelKeepButton"
                    style="@style/Widget.Drumigo.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ride_tracking_cancel_keep_ride" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelConfirmButton"
                    style="@style/Widget.Drumigo.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/ride_tracking_cancel_confirm" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
