<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ride_history_details_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:background="@drawable/bg_ride_history_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ride_tracking_panic_sheet_title"
            android:textSize="@dimen/text_lg" />

        <ImageView
            android:id="@+id/panicCloseButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_ride_history_sheet_close"
            android:contentDescription="@string/ride_tracking_panic_close"
            android:padding="7dp"
            android:src="@drawable/ic_close_simple"
            app:tint="@color/text_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/panicStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:backgroundTint="@color/bg_cream"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingTop="5dp"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingBottom="5dp"
        android:text="@string/ride_tracking_panic_status_ready"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/text_sm"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/panicHoldButton"
                    style="@style/Widget.Drumigo.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/ride_tracking_panic_hold_label"
                    app:backgroundTint="@color/error"
                    app:icon="@drawable/ic_warning"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/spacing_xs"
                    app:iconTint="@color/white" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/panicHoldProgress"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:indeterminate="false"
                    android:max="100"
                    android:visibility="invisible"
                    app:indicatorColor="@color/error"
                    app:trackColor="@color/border" />

                <TextView
                    android:id="@+id/panicInstructionText"
                    style="@style/TextStyle.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_horizontal"
                    android:text="@string/ride_tracking_panic_sheet_subtitle"
                    android:textColor="@color/text_medium" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        style="@style/TextStyle.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_panic_driver_label" />

                    <TextView
                        android:id="@+id/panicDriverValue"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_driver_placeholder"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextStyle.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/ride_tracking_panic_vehicle_label" />

                    <TextView
                        android:id="@+id/panicVehicleValue"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_vehicle_placeholder"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextStyle.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/ride_tracking_panic_current_location_label" />

                    <TextView
                        android:id="@+id/panicCurrentLocationValue"
                        style="@style/TextStyle.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ride_tracking_panic_current_location_unknown"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/panicWhatHappensSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    style="@style/TextStyle.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ride_tracking_panic_what_happens_title"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/success" />

                    <TextView
                        style="@style/TextStyle.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/ride_tracking_panic_happens_1"
                        android:textColor="@color/text_medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/success" />

                    <TextView
                        style="@style/TextStyle.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/ride_tracking_panic_happens_2"
                        android:textColor="@color/text_medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/success" />

                    <TextView
                        style="@style/TextStyle.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/ride_tracking_panic_happens_3"
                        android:textColor="@color/text_medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/success" />

                    <TextView
                        style="@style/TextStyle.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/ride_tracking_panic_happens_4"
                        android:textColor="@color/text_medium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panicActiveInfoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_estimate_note"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone">

                <TextView
                    style="@style/TextStyle.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ride_tracking_panic_status_sent"
                    android:textColor="@color/error"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextStyle.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/ride_tracking_panic_active_message"
                    android:textColor="@color/text_medium" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
