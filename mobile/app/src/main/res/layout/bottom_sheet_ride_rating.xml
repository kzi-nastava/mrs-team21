<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ride_history_details_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:background="@drawable/bg_ride_history_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextStyle.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ride_rating_title"
            android:textSize="@dimen/text_lg" />

        <ImageView
            android:id="@+id/rideRatingCloseButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_ride_history_sheet_close"
            android:contentDescription="@string/ride_rating_close"
            android:padding="7dp"
            android:src="@drawable/ic_close_simple"
            app:tint="@color/text_medium" />
    </LinearLayout>

    <!-- Route summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_route_dot_start" />

            <View
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_route_line" />

            <TextView
                android:id="@+id/rideRatingOriginText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_route_dot_end" />

            <TextView
                android:id="@+id/rideRatingDestinationText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_medium"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Driver rating -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/ride_rating_driver_label"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/rideRatingDriverStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rideRatingDriverStar1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/ride_rating_star"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingDriverStar2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingDriverStar3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingDriverStar4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingDriverStar5"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />
    </LinearLayout>

    <!-- Vehicle rating -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/ride_rating_vehicle_label"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/rideRatingVehicleStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rideRatingVehicleStar1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/ride_rating_star"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingVehicleStar2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingVehicleStar3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingVehicleStar4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />

        <ImageView
            android:id="@+id/rideRatingVehicleStar5"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/ride_rating_stars"
            android:padding="4dp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/text_light" />
    </LinearLayout>

    <!-- Comment -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/rideRatingCommentLayout"
        style="@style/Widget.Drumigo.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/ride_rating_comment_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/rideRatingCommentInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:maxLength="500"
            android:hint="@string/ride_rating_comment_placeholder" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/rideRatingCharCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:textColor="@color/text_light"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/rideRatingErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textColor="@color/error"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rideRatingSkipButton"
            style="@style/Widget.Drumigo.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/ride_rating_skip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rideRatingSubmitButton"
            style="@style/Widget.Drumigo.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/ride_rating_submit" />
    </LinearLayout>
</LinearLayout>
