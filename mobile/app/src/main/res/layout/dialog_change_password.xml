<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/spacing_lg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_change_password"
            style="@style/TextStyle.Title"
            android:textSize="@dimen/text_xl" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close_circle"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/btn_cancel" />
    </LinearLayout>

    <!-- Current Password Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/currentPasswordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        style="@style/Widget.Drumigo.TextInputLayout"
        android:hint="@string/password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            style="@style/Widget.Drumigo.TextInputEditText" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- New Password Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/newPasswordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        style="@style/Widget.Drumigo.TextInputLayout"
        android:hint="@string/new_password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            style="@style/Widget.Drumigo.TextInputEditText" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm New Password Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/confirmPasswordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        style="@style/Widget.Drumigo.TextInputLayout"
        android:hint="@string/confirm_password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            style="@style/Widget.Drumigo.TextInputEditText" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Requirements -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_password_requirements"
        android:padding="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password_requirements_title"
            android:textColor="@color/text_medium"
            android:textSize="@dimen/text_xs"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Requirement: Length -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/reqLengthIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_small"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/reqLengthText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/requirement_length"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- Requirement: Uppercase -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/reqUpperIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_small"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/reqUpperText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/requirement_uppercase"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- Requirement: Lowercase -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/reqLowerIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_small"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/reqLowerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/requirement_lowercase"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- Requirement: Special -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/reqSpecialIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_small"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/reqSpecialText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/requirement_special"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPassword"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/btn_cancel"
            style="@style/Widget.Drumigo.Button.Secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/btn_change_password"
            style="@style/Widget.Drumigo.Button.Primary" />
    </LinearLayout>

</LinearLayout>