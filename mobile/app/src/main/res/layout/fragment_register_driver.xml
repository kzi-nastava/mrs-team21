<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    tools:context=".ui.admin.RegisterDriverFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xxl">

        <!-- Step indicator -->
        <TextView
            android:id="@+id/stepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_light"
            android:textSize="@dimen/text_sm" />

        <!-- ========== STEP 1: Driver information ========== -->
        <LinearLayout
            android:id="@+id/step1Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_driver_step1_title"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_title" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/register_driver_step1_subtitle"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_body" />

            <!-- Profile photo (optional) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_password_requirements"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <FrameLayout
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_avatar_placeholder">

                    <ImageView
                        android:id="@+id/driverPhotoImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@string/profile_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/profile_photo"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/register_driver_photo_hint"
                        android:textColor="@color/text_light"
                        android:textSize="@dimen/text_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uploadPhotoButton"
                        style="@style/Widget.Drumigo.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:minHeight="0dp"
                        android:text="@string/upload_photo" />
                </LinearLayout>
            </LinearLayout>

            <!-- First name, Last name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/firstNameInputLayout"
                    style="@style/Widget.Drumigo.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/first_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/firstNameInput"
                        style="@style/Widget.Drumigo.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/lastNameInputLayout"
                    style="@style/Widget.Drumigo.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:hint="@string/last_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lastNameInput"
                        style="@style/Widget.Drumigo.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                style="@style/Widget.Drumigo.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    style="@style/Widget.Drumigo.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone: country code + number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/countryCodeInputLayout"
                    style="@style/Widget.Drumigo.TextInputLayout"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/countryCodeInput"
                        style="@style/Widget.Drumigo.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:text="@string/country_code_default" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneInputLayout"
                    style="@style/Widget.Drumigo.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/phone_number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInput"
                        style="@style/Widget.Drumigo.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/addressInputLayout"
                style="@style/Widget.Drumigo.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/home_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/addressInput"
                    style="@style/Widget.Drumigo.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Continue to vehicle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.Drumigo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/register_driver_continue" />
        </LinearLayout>

        <!-- ========== STEP 2: Vehicle information ========== -->
        <LinearLayout
            android:id="@+id/step2Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_driver_step2_title"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_title" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/register_driver_step2_subtitle"
                android:textColor="@color/text_light"
                android:textSize="@dimen/text_body" />

            <!-- Vehicle model -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/vehicleModelInputLayout"
                style="@style/Widget.Drumigo.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:hint="@string/register_driver_vehicle_model">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/vehicleModelInput"
                    style="@style/Widget.Drumigo.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Vehicle category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/register_driver_vehicle_category"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_body" />
            <Spinner
                android:id="@+id/vehicleCategorySpinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="@dimen/input_padding_horizontal"
                android:paddingVertical="@dimen/input_padding_vertical"
                android:spinnerMode="dropdown" />

            <!-- License plate -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/licensePlateInputLayout"
                style="@style/Widget.Drumigo.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/register_driver_vehicle_license_plate">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/licensePlateInput"
                    style="@style/Widget.Drumigo.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:imeOptions="actionNext"
                    android:maxLength="12" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Number of seats -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/register_driver_vehicle_seats"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_body" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/seatsMinusButton"
                    style="@style/Widget.Drumigo.Button.Text"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="−"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/seatsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/text_lg"
                    android:minWidth="24dp"
                    android:gravity="center"
                    tools:text="4" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/seatsPlusButton"
                    style="@style/Widget.Drumigo.Button.Text"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="+"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Baby seats, Pet friendly -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/babySeatsCheckbox"
                style="@style/Widget.Drumigo.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/register_driver_vehicle_baby_seats" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/petFriendlyCheckbox"
                style="@style/Widget.Drumigo.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/register_driver_vehicle_pet_friendly" />

            <!-- Activation note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_info_box_accent"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/register_driver_activation_note"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <!-- Back + Register driver -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backButton"
                    style="@style/Widget.Drumigo.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/register_driver_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerButton"
                    style="@style/Widget.Drumigo.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/register_driver_submit" />
            </LinearLayout>
        </LinearLayout>

        <!-- Success message (visible after submit) -->
        <LinearLayout
            android:id="@+id/successContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center"
            android:padding="@dimen/spacing_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_driver_success"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_lg"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerAnotherButton"
                style="@style/Widget.Drumigo.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/register_driver_register_another" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
